# Virtual environment
.venv/

#Data
data/

# Python cache
__pycache__/
*.py[cod]

# Model files: fraud_model.pkl (~1.7MB) is intentionally NOT ignored -- it's small
# enough to commit directly and the app/Docker image needs it to be reproducible
# from a fresh clone. If models grow larger later, switch to Git LFS instead of
# just re-adding a blanket "*.pkl" ignore here (that would silently break clones).
.ipynb_checkpoints/

# IDE-specific files
.vscode/
.idea/

# Environment variables
.env

# Logs
*.log